# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# --- The vendored FBNAS baseline ------------------------------------------
# FBNAS/ mirrors the upstream repository exactly, and upstream ships
# __pycache__/*.pyc and codes/netInitModels/*.pth.  Those blobs are already
# tracked, and ignore rules do not apply to tracked files, so they survive a
# fresh clone without any carve-out here.  Re-vendoring should stage with
# `git add -f FBNAS/` rather than un-ignoring the tree: a blanket `!FBNAS/**`
# also un-ignores locally regenerated bytecode, which then leaks into the
# frozen baseline and trips the integrity test in
# tests/test_fbnas_compatibility.py.

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Experiment outputs
runs/
outputs/
logs/
sh_log/
checkpoints/
wandb/
lightning_logs/
*.pth
*.ckpt

# Note: the tracked FBNAS baseline blobs -- including the *.pth and
# __pycache__/*.pyc that ship with upstream -- are unaffected by the *.pth and
# __pycache__ rules above, which only ever apply to untracked files.

# Data
data/
datasets/

# Environment / secrets
.env
.env.*
!.env.example

